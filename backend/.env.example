# Không bắt buộc. Nếu không điền, chatbot vẫn chạy bằng phản hồi rule-based nội bộ.
# Nếu muốn dùng Foza/Claude chatbot, copy file này thành .env rồi điền key thật.
ANTHROPIC_BASE_URL=https://api.foza.ai/v1
ANTHROPIC_MODEL=anthropic/claude-sonnet-4.6
ANTHROPIC_API_KEY=sk-foza-xxxxx

# Không bắt buộc. Nếu điền OPENAI_API_KEY, web có thể tạo ảnh tham khảo photorealistic
# sau khi nhận diện nhãn. Nếu không điền, backend tự dùng ảnh tham khảo offline bằng PIL.
OPENAI_API_KEY=
OPENAI_IMAGE_ENABLED=1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
